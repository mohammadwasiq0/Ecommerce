<%- include('header') %>

<div class="page-header">
  <div class="container">
    <h1>My Orders</h1>
    <p>Track and manage your orders</p>
  </div>
</div>

<div class="container">
  <% if (orders.length === 0) { %>
    <div class="empty-state">
      <i class="fas fa-truck"></i>
      <h3>No orders yet</h3>
      <p>Your order history will appear here</p>
      <a href="/products" class="btn btn-primary">Start Shopping</a>
    </div>
  <% } else { %>
    <div class="orders-list-detailed">
      <% orders.forEach(order => { %>
        <div class="order-card-detailed">
          <div class="order-detailed-header">
            <div class="order-detailed-info">
              <div class="order-id-badge">#ZNHB-<%= order.id %></div>
              <span class="order-detailed-date"><i class="far fa-calendar-alt"></i> <%= new Date(order.created_at).toLocaleDateString('en-IN', { year: 'numeric', month: 'long', day: 'numeric' }) %></span>
              <span class="order-detailed-time"><i class="far fa-clock"></i> <%= new Date(order.created_at).toLocaleTimeString('en-IN', { hour: '2-digit', minute: '2-digit' }) %></span>
            </div>
            <div class="order-detailed-statuses">
              <span class="order-status-badge status-<%= order.status %>"><i class="fas fa-<%= order.status === 'pending' ? 'clock' : (order.status === 'confirmed' ? 'check-circle' : (order.status === 'shipped' ? 'truck' : (order.status === 'delivered' ? 'check-double' : 'times-circle'))) %>"></i> <%= order.status.charAt(0).toUpperCase() + order.status.slice(1) %></span>
              <span class="order-payment-badge <%= order.payment_status %>"><i class="fas fa-<%= order.payment_status === 'paid' ? 'check-circle' : 'exclamation-circle' %>"></i> <%= order.payment_status === 'paid' ? 'Paid' : 'Unpaid' %></span>
            </div>
          </div>

          <div class="order-detailed-body">
            <% if (order.items && order.items.length > 0) { %>
              <div class="order-items-list">
                <% order.items.forEach(item => { %>
                  <div class="order-detailed-item">
                    <img src="<%= item.image %>" alt="<%= item.name %>" loading="lazy">
                    <div class="order-detailed-item-info">
                      <strong><%= item.name %></strong>
                      <span>Qty: <%= item.quantity %></span>
                    </div>
                    <div class="order-detailed-item-price">₹<%= Number(item.price * item.quantity).toLocaleString('en-IN') %></div>
                  </div>
                <% }) %>
              </div>
            <% } else { %>
              <p class="order-no-items">No items details available</p>
            <% } %>

            <div class="order-detailed-summary">
              <div class="order-summary-row">
                <span>Subtotal</span>
                <span>₹<%= Number(order.total).toLocaleString('en-IN') %></span>
              </div>
              <div class="order-summary-row">
                <span>Shipping</span>
                <span><%= order.total > 2999 ? 'FREE' : '₹199' %></span>
              </div>
              <div class="order-summary-row total">
                <span>Total</span>
                <span>₹<%= Number(order.total).toLocaleString('en-IN') %></span>
              </div>
            </div>
          </div>

          <% if (order.shipping_address) { %>
            <div class="order-detailed-address">
              <i class="fas fa-map-marker-alt"></i>
              <span><%= order.shipping_address %></span>
            </div>
          <% } %>

          <div class="order-detailed-footer">
            <a href="/orders/track/<%= order.id %>" class="btn btn-primary btn-sm"><i class="fas fa-search"></i> Track</a>
            <a href="/orders/<%= order.id %>/invoice" class="btn btn-outline btn-sm"><i class="fas fa-file-pdf"></i> Invoice</a>
          </div>
        </div>
      <% }) %>
    </div>
  <% } %>
</div>

<%- include('footer') %>
